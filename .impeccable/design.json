    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Charcoal action for main navigation and page actions.",
      "html": "<button class=\"ds-btn-primary\">Open the Lab <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;height:34px;padding:0 14px;border-radius:6px;border:1px solid #17191C;background:#17191C;color:#fff;font:500 13px/18px 'Schibsted Grotesk',system-ui,sans-serif;cursor:pointer;transition:background-color 150ms ease,transform 160ms cubic-bezier(0.22,1,0.36,1)}.ds-btn-primary svg{width:15px;height:15px}.ds-btn-primary:hover{background:#2B2E33}.ds-btn-primary:active{transform:scale(0.97)}.ds-btn-primary:focus-visible{outline:2px solid #0E6B63;outline-offset:2px}"
    },
    {
      "name": "Run Button",
      "kind": "button",
      "refersTo": "button-accent",
      "description": "Teal; reserved for the simulation Run action.",
      "html": "<button class=\"ds-btn-run\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M7 4v16l13-8z\"/></svg>Run</button>",
      "css": ".ds-btn-run{display:inline-flex;align-items:center;gap:8px;height:34px;padding:0 14px;border-radius:6px;border:1px solid #0E6B63;background:#0E6B63;color:#fff;font:500 13px/18px 'Schibsted Grotesk',system-ui,sans-serif;cursor:pointer;transition:background-color 150ms ease,transform 160ms cubic-bezier(0.22,1,0.36,1)}.ds-btn-run svg{width:15px;height:15px}.ds-btn-run:hover{background:#0A5750;border-color:#0A5750}.ds-btn-run:active{transform:scale(0.97)}.ds-btn-run:focus-visible{outline:2px solid #0E6B63;outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "White with strong hairline; toolbar actions such as Save as baseline and Export.",
      "html": "<button class=\"ds-btn-secondary\">Save as baseline</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;height:34px;padding:0 14px;border-radius:6px;border:1px solid #CBCBC5;background:#fff;color:#17191C;box-shadow:0 1px 1px rgba(23,25,28,0.04);font:500 13px/18px 'Schibsted Grotesk',system-ui,sans-serif;cursor:pointer;transition:background-color 150ms ease,border-color 150ms ease,transform 160ms cubic-bezier(0.22,1,0.36,1)}.ds-btn-secondary:hover{border-color:#9A9EA3;background:#FAFAF8}.ds-btn-secondary:active{transform:scale(0.97)}.ds-btn-secondary:focus-visible{outline:2px solid #0E6B63;outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Transparent tertiary action.",
      "html": "<button class=\"ds-btn-ghost\">How the model works</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;height:34px;padding:0 14px;border-radius:6px;border:1px solid transparent;background:transparent;color:#4A4F55;font:500 13px/18px 'Schibsted Grotesk',system-ui,sans-serif;cursor:pointer;transition:background-color 150ms ease,color 150ms ease}.ds-btn-ghost:hover{background:#EFEFEC;color:#17191C}.ds-btn-ghost:focus-visible{outline:2px solid #0E6B63;outline-offset:2px}"
    },
    {
      "name": "Numeric Field",
      "kind": "input",
      "refersTo": "field-numeric",
      "description": "Instrument-style parameter entry with the unit beside it.",
      "html": "<label class=\"ds-param\"><span class=\"ds-param-label\">Substrate <i>S</i><sub>0</sub></span><input class=\"ds-field\" value=\"10.0\"><span class=\"ds-unit\">g/L</span></label>",
      "css": ".ds-param{display:flex;align-items:center;gap:8px;width:240px;font:500 12px/16px 'Schibsted Grotesk',system-ui,sans-serif;color:#4A4F55}.ds-param-label{flex:1}.ds-param-label i{font-family:'STIX Two Text',Cambria,serif}.ds-field{height:28px;width:4.75rem;padding:0 8px;border-radius:4px;border:1px solid #CBCBC5;background:#fff;color:#17191C;text-align:right;font:400 13px/18px 'Red Hat Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums;transition:border-color 150ms ease,box-shadow 150ms ease}.ds-field:hover{border-color:#9A9EA3}.ds-field:focus{outline:none;border-color:#0E6B63;box-shadow:0 0 0 3px rgba(14,107,99,0.14)}.ds-unit{width:32px;font:400 11px/14px 'Red Hat Mono',ui-monospace,monospace;color:#6B7077}"
    },
    {
      "name": "Segmented Control",
      "kind": "chip",
      "refersTo": "segmented",
      "description": "Sunken track with a sliding white pill; mode, speed and view toggles.",
      "html": "<div class=\"ds-seg\"><button class=\"ds-seg-item\">1x</button><button class=\"ds-seg-item\">2x</button><button class=\"ds-seg-item is-on\">4x</button><button class=\"ds-seg-item\">8x</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:2px;padding:3px;border-radius:6px;border:1px solid #E3E3DF;background:#EFEFEC}.ds-seg-item{height:28px;padding:0 12px;border:0;border-radius:4px;background:transparent;color:#6B7077;font:500 13px/18px 'Schibsted Grotesk',system-ui,sans-serif;cursor:pointer;transition:color 250ms cubic-bezier(0.22,1,0.36,1),background-color 250ms cubic-bezier(0.22,1,0.36,1)}.ds-seg-item:hover{color:#17191C}.ds-seg-item.is-on{background:#fff;color:#17191C;box-shadow:0 0 0 1px rgba(23,25,28,0.06),0 1px 2px rgba(23,25,28,0.08)}.ds-seg-item:focus-visible{outline:2px solid #0E6B63;outline-offset:2px}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "Sticky bar with centred links and a 1.5px ink underline under the active route.",
      "html": "<nav class=\"ds-nav\"><span class=\"ds-nav-brand\">Bioreactor Lab</span><div class=\"ds-nav-links\"><a class=\"is-active\">Lab</a><a>Experiments</a><a>Learn</a><a>Methodology</a></div><a class=\"ds-nav-cta\">Open the Lab</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;justify-content:space-between;height:52px;padding:0 24px;background:#F6F6F4;border-bottom:1px solid #E3E3DF;font-family:'Schibsted Grotesk',system-ui,sans-serif}.ds-nav-brand{font-weight:600;font-size:15px;letter-spacing:-0.01em;color:#17191C}.ds-nav-links{display:flex;gap:4px;height:100%}.ds-nav-links a{position:relative;display:flex;align-items:center;padding:0 12px;font-size:13px;font-weight:500;color:#6B7077;cursor:pointer;transition:color 150ms ease}.ds-nav-links a:hover,.ds-nav-links a.is-active{color:#17191C}.ds-nav-links a.is-active::after{content:'';position:absolute;left:0;right:0;bottom:-1px;height:1.5px;background:#17191C}.ds-nav-cta{height:28px;padding:0 10px;display:inline-flex;align-items:center;border-radius:6px;background:#17191C;color:#fff;font-size:12px;font-weight:500}"
    },
    {
      "name": "Readout Row",
      "kind": "custom",
      "refersTo": "sheet",
      "description": "Observe list row: series key, label with symbol, tabular mono value and unit.",
      "html": "<div class=\"ds-readout\"><span class=\"ds-key\" style=\"color:#C18A12\"></span><span class=\"ds-rlabel\">Biomass <i>X</i></span><span class=\"ds-rval\">3.511<small>g/L</small></span></div>",
      "css": ".ds-readout{display:flex;align-items:center;gap:10px;width:260px;padding:10px 0;border-bottom:1px solid #E3E3DF;font-family:'Schibsted Grotesk',system-ui,sans-serif}.ds-key{width:14px;height:2px;border-radius:2px;background:currentColor}.ds-rlabel{flex:1;font-size:12px;font-weight:500;color:#4A4F55}.ds-rlabel i{font-family:'STIX Two Text',Cambria,serif}.ds-rval{font:400 20px/1 'Red Hat Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums;color:#17191C}.ds-rval small{margin-left:4px;font-size:11px;color:#6B7077}"
